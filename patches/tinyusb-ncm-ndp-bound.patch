# Bounds the NCM NDP16 table to the received NTB (L2). Without it, recv_validate_datagram()
# reads ndp16_datagram[max_ndx - 1] at wNdpIndex + wLength, which a host can place past the end
# of the receive buffer (out-of-bounds read on the USB host -> device path).
# managed_components/ is regenerated by the component manager, so apply after each fetch:
#   patch -p1 -d managed_components/espressif__tinyusb < patches/tinyusb-ncm-ndp-bound.patch
# Checked against espressif/tinyusb 0.19.0~3. Report upstream to hathach/tinyusb and drop it once fixed there.
--- a/src/class/net/ncm_device.c	2026-11-15 13:30:50
+++ b/src/class/net/ncm_device.c	2026-11-15 13:30:51
@@ -576,6 +576,10 @@
 
   if (ndp16->wLength < sizeof(ndp16_t) + 2 * sizeof(ndp16_datagram_t)) {
     TU_LOG_DRV("(EE) ill ndp16 length: %d\n", ndp16->wLength);
+    return false;
+  }
+  if ((uint32_t) nth16->wNdpIndex + ndp16->wLength > len) {  // NDP and its terminator must lie inside the NTB
+    TU_LOG_DRV("(EE) ndp16 runs past the NTB: %d + %d > %lu\n", nth16->wNdpIndex, ndp16->wLength, len);
     return false;
   }
   if (ndp16->dwSignature != NDP16_SIGNATURE_NCM0 && ndp16->dwSignature != NDP16_SIGNATURE_NCM1) {
